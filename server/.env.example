NODE_ENV=production
HOST=0.0.0.0
PORT=8080
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/prem-power-laundry
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=https://pplwash.in,https://www.pplwash.in

# Needed only for admin alerts after the browser tab is closed.
# Generate the two keys ONCE with: npm run generate:vapid
# Never paste the <...> placeholder text. Add the generated values to Render.
# Use an email address you control as the VAPID contact subject.
VAPID_SUBJECT=mailto:your-real-email@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
