# Render backend service
NODE_ENV=production
HOST=0.0.0.0

# Render injects PORT automatically. Do not create a fixed PORT variable there.
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER/prem-power-laundry
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
CORS_ORIGINS=https://pplwash.in,https://www.pplwash.in

# Required only for background notifications when the admin tab is closed.
# Generate one matching pair with: npm run generate:vapid
VAPID_SUBJECT=mailto:owner@pplwash.in
VAPID_PUBLIC_KEY=PASTE_THE_GENERATED_PUBLIC_KEY
VAPID_PRIVATE_KEY=PASTE_THE_MATCHING_GENERATED_PRIVATE_KEY

# Socket.IO uses the same backend URL and port. It needs no extra environment variable.
